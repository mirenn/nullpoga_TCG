{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "outputs": [".next/**", "!.next/cache/**", "dist/**"],
            "dependsOn": ["^build"]
        },
        "test": {
            "outputs": [],
            "dependsOn": ["build"]
        },
        "lint": {
            "outputs": []
        },
        "typecheck": {
            "outputs": []
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}